{
  "name": "gluttony",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram bot that saves links and resurfaces them until you consume them",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:workers && npm run test:tooling",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:tooling": "vitest run --config vitest.tooling.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  }
}
